{
  "name": "connecteur-sage-shopify",
  "version": "0.2.0",
  "private": true,
  "description": "Connecteur Sage 100 (SODICO) <-> Shopify B2B",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalogue": "node --env-file-if-exists=.env src/cli-catalogue.js",
    "commandes": "node --env-file-if-exists=.env src/cli-commandes.js",
    "verifier": "node --env-file-if-exists=.env src/cli-verifier.js",
    "stocks": "node --env-file-if-exists=.env src/cli-stocks.js",
    "synchro": "node --env-file-if-exists=.env src/cli-synchro.js",
    "synchro-catalogue": "node --env-file-if-exists=.env src/cli-synchro.js --catalogue",
    "resume": "node --env-file-if-exists=.env src/cli-resume.js",
    "test-email": "node --env-file-if-exists=.env src/cli-test-email.js",
    "interface": "node --env-file-if-exists=.env src/cli-interface.js",
    "commandes-sage": "node --env-file-if-exists=.env src/cli-commandes-sage.js",
    "commandes-mode": "node --env-file-if-exists=.env src/cli-commandes-mode.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "msnodesqlv8": "^5.5.0",
    "mssql": "^12.7.2",
    "nodemailer": "^10.0.11"
  }
}
