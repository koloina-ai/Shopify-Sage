# Domaine de la boutique (sans https://)
SHOPIFY_STORE=ma-boutique-dev.myshopify.com

# Version de l'Admin API
SHOPIFY_API_VERSION=2026-07

# Authentification — renseigner UNE des deux options :

# Option A : token Admin API (shpat_...) d'une app custom
SHOPIFY_ACCESS_TOKEN=

# Option B : app créée depuis le Dev Dashboard (même organisation que la boutique)
# Le token (valable 24 h) est obtenu automatiquement par client credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
