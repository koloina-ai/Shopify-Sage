# ===== Shopify =====
SHOPIFY_STORE_URL=https://ma-boutique.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Authentification — renseigner UNE des deux options :
# Option A : token Admin API (shpat_...) d'une app custom
SHOPIFY_STORE_API_TOKEN=
# Option B : app créée depuis le Dev Dashboard (même organisation que la boutique)
# Le token (valable 24 h) est obtenu automatiquement par client credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Délai maximum d'un appel Shopify avant nouvelle tentative (ms)
SHOPIFY_DELAI_MS=30000

# ===== Catalogue (1 famille Sage = 1 produit, 1 article = 1 variante) =====
# Familles Sage synchronisées : codes FA_CodeFamille séparés par des virgules, ou * pour toutes
CATALOGUE_FAMILLES=04BQPSE,04PATCRT,04GASSV,04BTPET,04EMBP,04PATPLA,05INJPO,04SACPL,04VAI,04MACH,04BQPET,04FCX,05THEBTPP,04BQPP,04ALU,04FPVC,05CDTPAL,05THEBQPET,05INJGL,04DIVERS
# Dépôts dont le stock est additionné (intitulés Sage séparés par des virgules)
STOCK_DEPOTS=Magasin SODICO
# Passage du catalogue et des prix : toutes les N heures (les stocks passent à chaque synchro)
CATALOGUE_INTERVALLE_HEURES=24

# ===== Protection de la boutique =====
# Variation de prix maximale appliquée automatiquement (0.5 = ±50 %), au-delà : signalée mais non appliquée. 0 = désactivé
PRIX_VARIATION_MAX=0.5
# Statut des familles créées : ACTIVE (en vente) ou DRAFT (brouillon, à publier à la main après relecture)
PRODUITS_STATUT_CREATION=ACTIVE

# ===== Sage (SQL Server) =====
# Par défaut : localhost, base SODICO_TEST, authentification Windows
# SAGE_SQL_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=<serveur>;Database=<base>;Trusted_Connection=yes;TrustServerCertificate=yes;

# ===== Commandes Shopify -> Sage (3e étape de npm run synchro) =====
# off (défaut) : désactivé · tampon : option A, dépôt dans la base SODICO_CONNECTEUR · objets-metiers : option B (à venir)
COMMANDES_MODE=off
# Base de la zone tampon (créée par sql/tampon-commandes.sql). Par défaut : localhost, SODICO_CONNECTEUR, authentification Windows
# COMMANDES_SQL_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=<serveur>;Database=SODICO_CONNECTEUR;Trusted_Connection=yes;TrustServerCertificate=yes;
# Premier lancement : reprendre les commandes à partir de cette date (défaut : 7 derniers jours)
COMMANDES_DEPUIS=
# Client Sage (CT_Num) des commandes sans entreprise B2B ; vide = ces commandes passent « à vérifier »
COMMANDES_CLIENT_PAR_DEFAUT=

# ----- Option B : Objets Métiers Sage (COMMANDES_MODE=objets-metiers) -----
# Société Sage (fournie par M2I) : fichier commercial .gcm, OU serveur SQL + base
OM_FICHIER_GCM=
# OM_SERVEUR_SQL=
# OM_BASE_SQL=
# (optionnel) fichier comptable .mae ; sinon la comptabilité liée à la base commerciale
OM_FICHIER_MAE=
# Utilisateur Sage dédié au connecteur
OM_UTILISATEUR=
OM_MOT_DE_PASSE=
# (optionnels) souche et dépôt des commandes web, par leur intitulé Sage
OM_SOUCHE=
OM_DEPOT=
# Prix des lignes : shopify (défaut, prix payé par le client) | sage (tarif Sage du client recalculé)
OM_PRIX=shopify
# Référence de la pièce Sage (DO_Ref) = préfixe + n° Shopify, ex. WEB1004
OM_PREFIXE_REF=WEB
# Les Objets Métiers sont une bibliothèque 32 bits (manuel Sage) : laisser 32
OM_ARCHITECTURE=32
# oui = tester toute la chaîne sans Sage (pièces fictives SIM00001…)
OM_SIMULATION=

# ===== E-mails (alertes et résumé quotidien) =====
# Sans SMTP_HOST ni ALERTE_A, aucun e-mail n'est envoyé.
# SMTP_HOST=fichier : mode test, les e-mails sont écrits dans sortie/emails/*.eml
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur (par défaut : SMTP_USER)
ALERTE_DE=
# Destinataires, séparés par des virgules
ALERTE_A=
# Rappel tant qu'une panne dure (heures)
RAPPEL_HEURES=4

# ===== Page de suivi (npm run interface) =====
# Par défaut : seulement depuis ce poste (127.0.0.1). 0.0.0.0 = accessible depuis le réseau local.
INTERFACE_HOTE=127.0.0.1
INTERFACE_PORT=3000
# Obligatoire si INTERFACE_HOTE=0.0.0.0 (identifiant libre, seul le mot de passe compte) :
# sans lui la page refuse de démarrer, sauf INTERFACE_SANS_MOT_DE_PASSE=oui. 5 erreurs = poste bloqué 5 min.
INTERFACE_MOT_DE_PASSE=
# Noms acceptés en plus de localhost, du nom du serveur et de ses adresses IP (ex. un alias DNS), séparés par des virgules
INTERFACE_NOMS=
# Intervalle de la tâche planifiée (min) : au-delà de 2 intervalles sans synchro, la page passe en orange
INTERVALLE_SYNCHRO_MIN=15

# ===== Journaux =====
# Durée de conservation des journaux, rapports et e-mails de test (jours)
JOURS_CONSERVATION=30
